@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(OpenSSL 3.0 REQUIRED)
find_dependency(Boost 1.75 REQUIRED COMPONENTS 
    system 
    chrono 
    date_time 
    timer 
    thread 
    coroutine
    filesystem
    program_options
)
find_dependency(Threads REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/ss_p2p-targets.cmake")

check_required_components(ss_p2p)