{
    "node": {
        "endpoint": {
            "host": "0.0.0.0",
            "port": 8080
        },
        "bootstrap_nodes": [
            {
                "host": "bootstrap1.example.com",
                "port": 8080
            },
            {
                "host": "bootstrap2.example.com",
                "port": 8080
            }
        ]
    },
    "network": {
        "transport": "udp",
        "max_message_size": 65536,
        "connection_timeout": 30,
        "keep_alive_interval": 10
    },
    "dht": {
        "k_bucket_size": 20,
        "alpha": 3,
        "lookup_timeout": 5,
        "refresh_interval": 3600,
        "replication_factor": 3
    },
    "ice": {
        "enable_nat_traversal": true,
        "stun_timeout": 3,
        "turn_bandwidth_limit": 1048576,
        "candidate_gathering_timeout": 10
    },
    "security": {
        "enable_encryption": true,
        "cipher_suite": "AES-256-GCM",
        "key_rotation_interval": 86400,
        "enable_authentication": true
    },
    "chat": {
        "username": "user",
        "display_name": "Anonymous User",
        "message_history_limit": 1000,
        "enable_file_transfer": true,
        "max_file_size": 104857600
    },
    "logging": {
        "level": "info",
        "file": "ss_p2p_chat.log",
        "console": true,
        "max_file_size": 10485760,
        "max_files": 5
    },
    "service": {
        "daemon": false,
        "pid_file": "/var/run/ss_p2p_chat.pid",
        "working_directory": ".",
        "user": "",
        "group": ""
    }
}